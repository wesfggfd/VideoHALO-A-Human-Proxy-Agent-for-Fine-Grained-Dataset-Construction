# Copy this file to .env and replace placeholders locally. Never commit .env.
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global
VIDEOHALO_GCS_BUCKET=your-private-same-project-bucket
VIDEOHALO_GCS_PREFIX=videohalo/original-video
GOOGLE_GENAI_USE_ENTERPRISE=true
VIDEOHALO_GEMINI_MODEL=gemini-3.6-flash
VIDEOHALO_GEMINI_SERVICE_TIER=flex
VIDEOHALO_MODEL_REQUESTS_PER_MINUTE=8
VIDEOHALO_NODE_TIMEOUT=1800
VIDEOHALO_FLEX_MAX_ATTEMPTS=3
VIDEOHALO_FLEX_RETRY_BASE_SECONDS=5
VIDEOHALO_SELECTION_SEED=42
VIDEOHALO_ARTIFACT_ROOT=artifacts

